<Window x:Class="SiegeServerChanger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="레식 서버 변경기" Width="600" Height="740" MinWidth="520" MinHeight="520"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="app.ico">
    <Window.Resources>
        <!-- Borderless text button for the star toggle -->
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,0,8,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small pill for recent servers -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Profile -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="프로필" VerticalAlignment="Center" Foreground="{StaticResource FgMuted}" Margin="0,0,10,0"/>
            <ComboBox x:Name="ProfileBox" Grid.Column="1" SelectionChanged="ProfileBox_SelectionChanged" Padding="6,4" Foreground="Black"/>
            <CheckBox x:Name="AllProfilesBox" Grid.Column="2" Content="모든 프로필에 적용" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- Current -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="현재 서버" Foreground="{StaticResource FgMuted}" FontSize="12"/>
                <TextBlock x:Name="CurrentText" Text="-" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- List header -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="서버 목록" FontWeight="SemiBold"/>
                <TextBlock Text="☆를 누르면 즐겨찾기 · 핑은 AWS 리전까지의 참고용 수치" Foreground="{StaticResource FgMuted}" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PingButton" Content="핑 측정" Click="Ping_Click"/>
                <Button x:Name="FastestButton" Content="가장 빠른 서버" Click="Fastest_Click" Margin="0" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Recent -->
        <StackPanel x:Name="RecentRow" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="최근" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding DisplayName}" Style="{StaticResource ChipButton}" Click="Recent_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Server list -->
        <ListBox x:Name="ServerList" Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                 Foreground="{StaticResource Fg}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ServerList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource PanelHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2A4A7A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding StarText}" ToolTip="{Binding StarTip}" Style="{StaticResource StarButton}"
                                IsEnabled="{Binding CanFavorite}" Click="Star_Click"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Region}" Foreground="{StaticResource FgMuted}" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding PingText}" Foreground="{Binding PingBrush}" FontFamily="Consolas" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding Marker}" Foreground="{StaticResource Accent}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Warning -->
        <Border x:Name="WarnBar" Grid.Row="5" Background="#3A3020" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                CornerRadius="6" Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="⚠ 게임이 실행 중입니다. 게임을 끈 뒤에 적용해야 설정이 덮어써지지 않습니다." Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="6" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="ApplyButton" Content="적용" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
            <Button x:Name="RestoreButton" Content="백업 복원" Click="Restore_Click"/>
            <Button Content="새로고침" Click="Refresh_Click"/>
            <Button Content="폴더 열기" Click="OpenFolder_Click"/>
            <Button x:Name="LaunchButton" DockPanel.Dock="Right" Content="▶ 게임 실행" Margin="0" Click="Launch_Click"/>
            <ComboBox x:Name="LauncherBox" DockPanel.Dock="Right" Margin="0,0,6,0" Padding="6,4" Foreground="Black"
                      VerticalContentAlignment="Center" SelectionChanged="LauncherBox_SelectionChanged" Visibility="Collapsed"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="7" Margin="0,10,0,0" Foreground="{StaticResource FgMuted}" TextWrapping="Wrap"/>
    </Grid>
</Window>
